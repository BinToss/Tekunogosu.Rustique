{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Debug executable 'rustique'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=rustique",
          "--package=rustique-cli"
        ]
      },
      "args": [ ]
    },
    {
      "name": "Debug command 'rustique info floatingcombattext'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=rustique",
          "--package=rustique-cli",
          "--",
          "info",
          "floatingcombattext"
        ]
      },
      "args": [ ]
    },
    {
      "name": "Debug command 'rustique -d sync'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=rustique",
          "--package=rustique-cli",
          "--",
          "-d",
          "sync"
        ]
      },
      "args": [ ]
    },
    {
      "name": "Debug command 'rustique -d list -uc name mod-id version latest-version'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=rustique",
          "--package=rustique-cli",
          "--",
          "-d",
          "list",
          "-uc",
          "name",
          "mod-id",
          "version",
          "latest-version"
        ]
      },
      "args": [ ]
    },
    {
      "name": "Debug command 'rustique -d modpack create --name \\'Forgotten Armory\\' --mpk-id forgottenarmory --mpk-version 1.0.0 --copy-mods'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=rustique",
          "--package=rustique-cli",
          "--",
          "-d",
          "modpack",
          "create",
          "--name", "Forgotten Armory",
          "--mpk-id", "forgottenarmory",
          "--mpk-version", "1.0.0 ",
          "--copy-mods"
        ]
      },
      "args": [ ]
    },
    {
      "name": "Debug unit tests in executable 'rustique'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--bin=rustique",
          "--package=rustique-cli"
        ]
      }
    },
    {
      "name": "Debug unit tests in library 'rustique_core'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--package=rustique-core"
        ]
      }
    }
  ]
}